orig_cwd: "."

mode:
  ddp: true # true # true # true # false 
  nni: false
  accelerate: false # true # false
  # full: false # training full dataset
  # data: random # random, test_not_in_train, test_in_train
  # debiase: false
  # deepspeed:
  #   config: /data/home/scv6872/Breeze/configs/ds_config.json

task:
  type: pretrain # binary # affinity, multitask, contact_map
  pretrain:  
    default_metric: accuracy # loss
  
  
train:
  random_seed: 0
  num_epoch: 1000
  batch_size: 256
  num_workers: 1
  learning_rate: 1e-4
  adam_epsilon: 1e-8
  weight_decay: 0.01
  lr_scheduler:
    type: cosine # cosine, plateau
    when: batch  # batch, epoch
    cosine:
      T_0: 100
      T_mult: 2
      eta_min: 1e-6
  eval_epoch: 10
  pin_memory: False
  device_ids: [0,1,2,3]

  # add some variable for model training like config.json
model:
  initial:
    initial_weight: true # true
    model_name: "/home/bingxing2/public/models/facebook/esm2_t6_8M_UR50D" # "/data/public/models/llama/llama-13b/" # "/data/public/models/facebook/esm2_t48_15B_UR50D/" # "" # "/data/public/models/facebook/esm2_t36_3B_UR50D/" # "roberta-base", "facebook/bart-base","facebook/esm2_t33_650M_UR50D", "facebook/esm1b_t33_650M_UR50S","bert-base-uncased", "xlnet-base-cased", "gpt2"
  mask_data:
    masked_lm_prob: 0.15 # 15% amiono acid will be covered; 80% times for mask, 10% times for mutation, 10% stays the same
    max_predictions_per_seq: 20 # modify later 
    max_length: 52
  dir: /home/bingxing2/home/scx6509/test/Breeze/models/files/t6
data:
  train_file: "/home/bingxing2/home/scx6509/test/Breeze/dataset/eval_v9.csv" # "./data/v5/v5_final.csv"
  valid_file: "/home/bingxing2/home/scx6509/test/Breeze/dataset/eval_v9.csv"
  repeat: 10
  max_length: 52
  # test_file: "/data/home/scv6872/Cambridge/data/AMPScan/AMPScan_test.fa"
  dataset_file: "" # if seperate is false
  
logger:
  log: True
  log_dir: "outputs"
  log_per_steps: 50
  final_artifact_path: final

